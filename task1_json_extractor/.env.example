# Copy this file to .env and fill in the provider you intend to use.
# Never commit .env or real API keys.

# Required: "gemini" or "openai". Exactly one provider is used per run.
LLM_PROVIDER=gemini

# Required only when LLM_PROVIDER=gemini.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Gemini model override.
GEMINI_MODEL=gemini-2.5-flash

# Required only when LLM_PROVIDER=openai.
OPENAI_API_KEY=your_openai_api_key_here

# Optional OpenAI model override.
OPENAI_MODEL=gpt-4o-mini

# Optional request timeout in seconds (5-300).
LLM_TIMEOUT_SECONDS=60

# Optional extra retries after a malformed or schema-invalid model output (0-3).
LLM_MAX_OUTPUT_RETRIES=1
